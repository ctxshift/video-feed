{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun",
      "react"
    ],
    "paths": {
      "react-devtools-core": [
        "./stubs/react-devtools-core.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*"
  ]
}